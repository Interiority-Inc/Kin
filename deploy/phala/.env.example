# Kin Phala Cloud Deployment — Environment Variables
#
# Copy this file to .env and fill in the values.
# These are X25519-encrypted client-side by the Phala CLI
# and decrypted only inside the CVM.

# Required: API key for the Phala Confidential Inference API
PHALA_INFERENCE_API_KEY=your-api-key-here

# Inference endpoint (default works for Phala's hosted API)
INFERENCE_ENDPOINT=https://inference.phala.com/v1

# Model to use (must have is_tee: true on Phala's catalog)
MODEL_ID=qwen/qwen3-32b

# PRIVATE system prompt template (the personality). This is the secret that
# shapes Kin's behavior. It is encrypted client-side by the Phala CLI and
# decrypted only inside the enclave -- it never appears in the repo, the
# image, or any log. The template MUST contain {spirit_content} and
# {verification_status} placeholders (literal braces must be doubled).
# See tee/prompts/README.md. NEVER commit this value.
KIN_SYSTEM_PROMPT=

# Set by CI/CD — leave empty for manual deploys
KIN_EXPECTED_CPU_MEASUREMENT=
KIN_CODE_HASH=
KIN_GIT_COMMIT=
